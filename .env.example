# Local configuration template and complete environment-variable contract.
# Copy to `.env` for local development only. Do not commit real values.

# Optional FastAPI settings. Generate APP_API_TOKEN yourself when needed, for
# example with: openssl rand -hex 32
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_API_TOKEN=

# Optional local token: Tailscale admin console > Settings > Keys > API access
# tokens. Use a short-lived token for local CLI use. GitHub Actions runtime
# requires complete OIDC settings and never falls back to TS_TOKEN.
TS_TOKEN=

# Non-secret OIDC identifiers: Tailscale admin console > Settings > Trust
# credentials. Required only when using the optional GitHub OIDC runtime.
# Never put an OIDC JWT or Tailscale access token here. These are configuration
# identifiers, not secrets.
TS_CLIENT_ID=
TS_AUDIENCE=

# Non-secret metadata. Use "-" for the credential's default tailnet, or copy the
# tailnet DNS name from the Tailscale admin console.
TAILNET=-

# Non-secret metadata from Tailscale admin console > Access controls. Prefer a
# dedicated tag whose devices are managed only by this automation. GitHub Actions
# runtime rejects wildcard SERVER_TAG; REJOIN_AUTH_KEY_TAG must be concrete.
SERVER_TAG=tag:tailwarden-managed
REJOIN_AUTH_KEY_TAG=tag:tailwarden-managed

# Operator-defined policy defaults.
STALE_AFTER_MINUTES=30
KEY_EXPIRY_WARNING_HOURS=168
AUTH_KEY_EXPIRY_SECONDS=3600
AUTH_KEY_DESCRIPTION=emergency server rejoin from tailwarden
# Local output is detailed by default. GitHub Actions runtime forces redaction.
REPORT_REDACT_DETAILS=false
# Step Summary only: publish API name short labels and controlled device states.
# The table is off by default.
REPORT_DEVICE_NAMES=false
DRY_RUN=false
# Exit policy for each run; CLI flags can override it.
FAIL_ON_STALE=true

# Operator-defined HTTP timeouts; the defaults are normally sufficient.
HTTP_TOTAL_TIMEOUT_SECONDS=20
HTTP_CONNECT_TIMEOUT_SECONDS=5

# GitHub Actions injects these in its runtime. They are optional compatibility
# fields for external automation; never copy OIDC request values into .env.
ACTIONS_ID_TOKEN_REQUEST_TOKEN=
ACTIONS_ID_TOKEN_REQUEST_URL=
GITHUB_STEP_SUMMARY=
GITHUB_ACTIONS=false
