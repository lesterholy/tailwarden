# Local configuration template and complete environment-variable contract.
# Copy to `.env` for local development only. Do not commit real values.

# Optional local FastAPI test settings. The scheduled GitHub Actions job does
# not use these values. Generate APP_API_TOKEN yourself when needed, for
# example with: openssl rand -hex 32
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_API_TOKEN=

# Optional local token: Tailscale admin console > Settings > Keys > API access
# tokens. Use a short-lived token and leave this empty in GitHub Actions.
TS_TOKEN=

# Non-secret OIDC identifiers: Tailscale admin console > Settings > Trust
# credentials. The workflow stores them as Environment Variables named
# TS_MANAGER_CLIENT_ID and TS_MANAGER_AUDIENCE, then maps them to the application
# names below. Never put an OIDC JWT or Tailscale access token here.
TS_CLIENT_ID=
TS_AUDIENCE=

# Non-secret metadata. Use "-" for the credential's default tailnet, or copy the
# tailnet DNS name from the Tailscale admin console. GitHub output is redacted.
TAILNET=-

# Non-secret metadata from Tailscale admin console > Access controls. Prefer a
# dedicated tag whose devices are managed only by this automation. GitHub
# Actions requires SERVER_TAG and REJOIN_AUTH_KEY_TAG to be concrete tags.
SERVER_TAG=tag:tailwarden-managed
REJOIN_AUTH_KEY_TAG=tag:tailwarden-managed

# Operator-defined policy. These defaults are also used by the workflow when
# no environment-level override is configured.
STALE_AFTER_MINUTES=30
KEY_EXPIRY_WARNING_HOURS=168
AUTH_KEY_EXPIRY_SECONDS=3600
AUTH_KEY_DESCRIPTION=emergency server rejoin from tailwarden
# Local output is detailed by default. GitHub Actions always forces redaction.
REPORT_REDACT_DETAILS=false
DRY_RUN=false
FAIL_ON_STALE=true

# Operator-defined HTTP timeouts; the defaults are normally sufficient.
HTTP_TOTAL_TIMEOUT_SECONDS=20
HTTP_CONNECT_TIMEOUT_SECONDS=5

# GitHub Actions injects these automatically at runtime. Never copy or create
# them as repository/environment variables or secrets.
ACTIONS_ID_TOKEN_REQUEST_TOKEN=
ACTIONS_ID_TOKEN_REQUEST_URL=
GITHUB_STEP_SUMMARY=
GITHUB_ACTIONS=false
